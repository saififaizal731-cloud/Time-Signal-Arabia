# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection (use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/tsa-ecommerce?retryWrites=true&w=majority

# JWT Secret (change this to a strong random string in production)
JWT_SECRET=your_very_secure_random_secret_key_change_this_in_production

# CORS Origins (comma-separated list of allowed domains)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
